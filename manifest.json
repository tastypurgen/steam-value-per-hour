{
  "manifest_version": 3,
  "name": "Steam Value Per Hour",
  "version": "0.2.1",
  "description": "Shows Steam price per hour using HowLongToBeat data and optional SteamDB price history.",
  "permissions": ["storage"],
  "host_permissions": ["https://howlongtobeat.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Steam Value Per Hour",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "steam-value-per-hour@addon.mozilla.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
